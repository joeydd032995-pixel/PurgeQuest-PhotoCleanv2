# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/

# Swift Package Manager. The app has no packages (tools/ci/repo_guard.py enforces that); these
# only appear if a tool creates them.
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store
*.swp
*~

# Rork
.rork/
.env
# Rork writes this file at build time with its own environment values. Nothing in the app reads it,
# and it must never be committed: repo_guard fails if a tracked copy holds a value.
Config.swift
